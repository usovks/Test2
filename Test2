<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Резюме — Константин Усов</title>
<style>
  :root{
    --bg:#0f1418;
    --panel:#161d24;
    --border:#263038;
    --text:#e8edf2;
    --muted:#9aa7b3;
    --accent:#4da3ff;
    --accent-soft:rgba(77,163,255,0.12);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{
    font-family:'Segoe UI',system-ui,-apple-system,Roboto,Arial,sans-serif;
    background:var(--bg);
    color:var(--text);
    line-height:1.55;
    padding:32px 16px;
  }
  .page{
    max-width:860px;
    margin:0 auto;
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:14px;
    padding:48px 52px;
    box-shadow:0 12px 40px rgba(0,0,0,0.45);
  }
  @media(max-width:640px){ .page{padding:28px 20px;} }

  header{
    border-bottom:2px solid var(--accent);
    padding-bottom:22px;
    margin-bottom:28px;
  }
  h1{
    font-size:34px;
    font-weight:700;
    letter-spacing:0.5px;
    margin-bottom:6px;
  }
  .desired{
    font-size:17px;
    color:var(--accent);
    font-weight:600;
    margin-bottom:4px;
  }
  .salary{ color:var(--muted); font-size:15px; margin-top:6px; }

  .contacts{
    display:flex;
    flex-wrap:wrap;
    gap:10px 26px;
    margin-top:16px;
    color:var(--muted);
    font-size:14px;
  }
  .contacts span b{ color:var(--text); font-weight:600; }

  section{ margin-bottom:30px; }
  h2{
    font-size:16px;
    text-transform:uppercase;
    letter-spacing:1.4px;
    font-weight:700;
    color:var(--accent);
    margin-bottom:16px;
    display:flex;
    align-items:center;
    gap:10px;
  }
  h2::after{
    content:"";
    flex:1;
    height:1px;
    background:var(--border);
  }

  /* Навыки */
  .skills{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
  }
  .skill{
    background:var(--accent-soft);
    border:1px solid rgba(77,163,255,0.25);
    color:var(--text);
    padding:7px 15px;
    border-radius:20px;
    font-size:14px;
  }

  /* Опыт работы */
  .job{
    position:relative;
    padding-left:24px;
    padding-bottom:24px;
    border-left:2px solid var(--border);
  }
  .job:last-child{ padding-bottom:0; }
  .job::before{
    content:"";
    position:absolute;
    left:-7px;
    top:5px;
    width:12px;
    height:12px;
    border-radius:50%;
    background:var(--accent);
    box-shadow:0 0 0 4px rgba(77,163,255,0.15);
  }
  .job-top{
    display:flex;
    justify-content:space-between;
    gap:16px;
    flex-wrap:wrap;
    margin-bottom:4px;
  }
  .job-title{
    font-size:16px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:0.4px;
  }
  .job-period{
    color:var(--muted);
    font-size:13px;
    white-space:nowrap;
    padding-top:3px;
  }
  .job-company{
    color:var(--accent);
    font-size:14px;
    font-weight:600;
    margin-bottom:8px;
  }
  .job ul{ list-style:none; }
  .job li{
    position:relative;
    padding-left:18px;
    margin-bottom:5px;
    font-size:15px;
    color:var(--text);
  }
  .job li::before{
    content:"";
    position:absolute;
    left:2px;
    top:8px;
    width:6px;
    height:6px;
    background:var(--accent);
    border-radius:50%;
  }

  /* Образование, языки, доп */
  .edu-item{ margin-bottom:12px; }
  .edu-row{ display:flex; gap:14px; align-items:baseline; flex-wrap:wrap; }
  .edu-year{
    color:var(--accent);
    font-weight:700;
    min-width:52px;
    font-size:14px;
  }
  .edu-name{ font-size:15px; }
  .edu-sub{ color:var(--muted); font-size:13px; }

  .info-table{ width:100%; border-collapse:collapse; }
  .info-table td{
    padding:8px 0;
    border-bottom:1px solid var(--border);
    font-size:15px;
    vertical-align:top;
  }
  .info-table td:first-child{
    color:var(--muted);
    width:220px;
  }
  .info-table tr:last-child td{ border-bottom:none; }

  .lang{ display:flex; align-items:center; gap:10px; }
  .lang-dot{ width:10px; height:10px; border-radius:50%; background:var(--accent); }
</style>
</head>
